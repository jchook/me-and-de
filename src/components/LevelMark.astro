---
import { LEVELS, type LevelCode } from '../lib/levels';

interface Props {
  level: LevelCode;
}

const { level } = Astro.props;
const filled = LEVELS.find((l) => l.code === level)?.filled ?? 0;
---

<span class="levelmark" aria-hidden="true">
  {Array.from({ length: 5 }, (_, i) => <i class:list={[{ on: i < filled }]}></i>)}
</span>
