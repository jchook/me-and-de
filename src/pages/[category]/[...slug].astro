---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { longDate, isoDate } from '../../lib/format';
import { categoryDef, categoryOf, slugOf } from '../../lib/categories';
import { tagDef } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const byCat = new Map();
  for (const p of posts) {
    const c = categoryOf(p.id);
    if (!byCat.has(c)) byCat.set(c, []);
    byCat.get(c).push(p);
  }
  return [...byCat.entries()].flatMap(([category, group]) => {
    // Prev/next read chronologically within the category.
    const ordered = group.sort((a, b) => +a.data.date - +b.data.date);
    return ordered.map((post, i) => ({
      params: { category, slug: slugOf(post.id) },
      props: { post, category, prev: ordered[i - 1] ?? null, next: ordered[i + 1] ?? null },
    }));
  });
}

const { post, category, prev, next } = Astro.props;
const { Content } = await render(post);

const cat = categoryDef(category);
const tags = post.data.tags.map(tagDef);
const headerNotes = tags.filter((t) => t.note?.placement === 'header');
const footerNotes = tags.filter((t) => t.note?.placement === 'footer');
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={isoDate(post.data.date)}>{longDate(post.data.date)}</time>
        <span>· <a
          class="cat"
          href={`/${cat.code}/`}
          style={cat.accent ? `--cat: var(--accent-${cat.accent})` : undefined}
        >{cat.label}</a></span>
        {tags.map((t) => <span>· <a class="tag" href={`/tags/${t.code}/`}>{t.label}</a></span>)}
      </p>
    </header>
    {
      headerNotes.map((t) => (
        <aside class="tag-note">
          <span class="tag-note-label">Note</span>
          <p set:html={t.note.html} />
        </aside>
      ))
    }
    <div class="prose">
      <Content />
    </div>
    {
      footerNotes.map((t) => (
        <aside class="tag-note">
          <span class="tag-note-label">Note</span>
          <p set:html={t.note.html} />
        </aside>
      ))
    }
    <nav class="post-foot" aria-label="More">
      {
        prev ? (
          <a class="foot-prev" href={`/${prev.id}/`} rel="prev">
            ← {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="foot-next" href={`/${next.id}/`} rel="next">
            {next.data.title} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>
