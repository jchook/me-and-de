---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { allCategories, categoryDef, categoryOf } from '../lib/categories';
import { shortDate, isoDate } from '../lib/format';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date
);

const cats = allCategories(posts.map((p) => p.id));
---

<Base>
  <div class="shelf">
    <span class="shelf-me" aria-hidden="true"></span>
    <nav class="shelf-cats" aria-label="Categories">
      {
        cats.map((c) => (
          <a
            href={`/${c.code}/`}
            aria-label={c.label}
            title={c.label}
            style={c.accent ? `--cat: var(--accent-${c.accent})` : undefined}
          />
        ))
      }
    </nav>
  </div>
  <ul class="post-list">
    {
      posts.map((post) => {
        const cat = categoryDef(categoryOf(post.id));
        return (
          <li>
            <a href={`/${post.id}/`}>{post.data.title}</a>
            <a
              class="cat"
              href={`/${cat.code}/`}
              style={cat.accent ? `--cat: var(--accent-${cat.accent})` : undefined}
            >
              {cat.label}
            </a>
            <time datetime={isoDate(post.data.date)}>{shortDate(post.data.date)}</time>
          </li>
        );
      })
    }
  </ul>
</Base>
