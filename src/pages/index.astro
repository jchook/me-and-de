---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { categoryDef, categoryOf } from '../lib/categories';
import { shortDate, isoDate } from '../lib/format';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date
);
---

<Base>
  <ul class="post-list">
    {
      posts.map((post) => {
        const cat = categoryDef(categoryOf(post.id));
        return (
          <li>
            <a href={`/${post.id}/`}>{post.data.title}</a>
            <a
              class="cat"
              href={`/${cat.code}/`}
              style={cat.accent ? `--cat: var(--accent-${cat.accent})` : undefined}
            >
              {cat.label}
            </a>
            <time datetime={isoDate(post.data.date)}>{shortDate(post.data.date)}</time>
          </li>
        );
      })
    }
  </ul>
</Base>
